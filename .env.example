# Local SQLite for development. Vercel uses prisma/schema.vercel.prisma and
# the managed PostgreSQL connection configured below in the deployment guide.
# SQLite file paths are relative to prisma/schema.prisma.
DATABASE_URL="file:../db/custom.db"

# Optional only for a Vercel deployment. The runtime uses the pooled URL;
# `npm run db:migrate:deploy` uses the direct DATABASE_URL.
DATABASE_URL_POOLED=""

# Google OAuth / NextAuth. Set these in Vercel for Production, Preview, and
# Development. Google callback URLs must include /api/auth/callback/google.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_GOOGLE_LOGIN_ENABLED="false"

# Vercel private Blob and the separate Docker processing worker.
BLOB_READ_WRITE_TOKEN=""
NEXT_PUBLIC_VERCEL_UPLOADS="false"
PROCESSING_WORKER_URL=""
PROCESSING_WORKER_TOKEN=""

# Optional local model settings. No API key is needed.
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen3:4b-instruct"
WHISPER_MODEL_PATH="models/ggml-small.bin"
