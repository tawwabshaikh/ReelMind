# Local development only. Vercel cannot persist SQLite files; migrate the
# Prisma schema and production data to a managed PostgreSQL database first.
# SQLite file paths are relative to prisma/schema.prisma.
DATABASE_URL="file:../db/custom.db"

# Optional local model settings. No API key is needed.
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen3:4b-instruct"
WHISPER_MODEL_PATH="models/ggml-small.bin"
